{
  "name": "devonlabs-space",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "wrangler pages dev out",
    "preview": "npm run build && wrangler pages dev out",
    "deploy": "npm run build && wrangler pages deploy out --project-name devonlabs-space",
    "refresh:github": "node scripts/refresh-github.mjs",
    "refresh:media": "node scripts/refresh-workshop.mjs",
    "refresh:bundles": "node scripts/refresh-photography-bundles.mjs",
    "lint": "eslint",
    "test": "node --test tests/photography-bundles.mjs && node tests/integrity.mjs",
    "test:browser": "node tests/portfolio.mjs && node tests/loading.mjs && node tests/shop.mjs && node tests/coverage.mjs && node tests/masonry.mjs",
    "images": "node scripts/generate-images.mjs",
    "prebuild": "npm run refresh:bundles && npm run images",
    "predev": "npm run images"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "16.3.8",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cheerio": "^1.2.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "playwright": "^1.62.1",
    "sharp": "^0.35.5",
    "typescript": "^5",
    "wrangler": "^4.149.0"
  }
}
